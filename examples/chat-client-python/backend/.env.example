# 127.0.0.1 works both for local (non-Docker) runs and inside the backend
# container — docker-compose.yml uses network_mode: host specifically so
# this doesn't need to change between the two. See docker-compose.yml's
# comment for why host.docker.internal does NOT work here (gen-ai and
# Ollama are both bound to 127.0.0.1 only, for security, and Linux does
# not route loopback-bound traffic across network-namespace boundaries).
GENAI_API_URL=http://127.0.0.1:8020
GENAI_API_KEY=gak_replace_with_a_real_key_from_the_gen-ai_admin_panel

CHAT_LLM_PROVIDER=ollama
CHAT_LLM_MODEL=llama3.2
CHAT_LLM_BASE_URL=http://127.0.0.1:11434
CHAT_LLM_API_KEY=

RECENT_MESSAGES_WINDOW=6
SEMANTIC_SEARCH_TOP_K=4
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=50
