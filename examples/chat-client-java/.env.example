# Copy to .env, then run scripts/register_app.sh to fill in GENAI_API_KEY
# automatically (or paste one you issued yourself via the admin panel).

GENAI_API_URL=http://127.0.0.1:8020
GENAI_API_KEY=

CHAT_LLM_PROVIDER=ollama
CHAT_LLM_MODEL=llama3.2
