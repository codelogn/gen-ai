CHAT_LLM_API_KEY=

RECENT_MESSAGES_WINDOW=6
SEMANTIC_SEARCH_TOP_K=4
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=50

POSTGRES_USER=chatclient
POSTGRES_PASSWORD=changeme_use_a_real_password
POSTGRES_DB=chatclient_java
